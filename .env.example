# .env.example
# Copy this file to .env.local and fill in real values. Never commit real secrets.

# Supabase (see lib/db/supabase.js)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron auth (see app/api/cron/route.js)
CRON_SECRET=

# Data source credentials (see lib/sources/*)
MYFXBOOK_EMAIL=
MYFXBOOK_PASSWORD=

# Massive.com futures API — up to 4 keys, rotated to work around the free
# tier's 5 calls/minute/key limit. At least 1 is required; 2-4 is optional
# but recommended for fewer rate-limit waits.
MASSIVE_API_KEY_1=
MASSIVE_API_KEY_2=
MASSIVE_API_KEY_3=
MASSIVE_API_KEY_4=
